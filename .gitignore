profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to https://github.com/pypa/pipenv/issues/199, there is no single file
#   that should be committed into git, but rather the Pipfile and Pipfile.lock.
#   However, Pipfile.lock is not generally useful for libraries, but is for apps.
#   https://pipenv.pypa.io/en/latest/basics/#pipfile-lock
#   In case Pipfile.lock is not committed, .venv should also be ignored.
.venv
Pipfile.lock

# poetry
#   Similar to pipenv, poetry.lock should be committed for apps, but not libraries.
poetry.lock

# pdm
#   Similar to pipenv, pdm.lock should be committed for apps, but not libraries.
pdm.lock
.pdm.toml
.pdm-build/

# PEP 582; used by e.g. pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

